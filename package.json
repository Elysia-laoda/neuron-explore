{
  "name": "neuron-explore",
  "version": "1.0.0",
  "description": "神经元探索：多路 AI 并行思考。三种形态——通用 CLI/库、三模式引擎（single/agent/fuse）、DSH 插件（注册成模型 provider，选中即替代单思考）。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./engine": "./lib/engine.mjs",
    "./http": "./lib/ask-http.mjs"
  },
  "files": [
    "lib",
    "test",
    "cli.mjs",
    "cordis.patch.yml",
    "README.md",
    "HANDOVER.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "schemastery": "^3.18.0"
  },
  "scripts": {
    "test": "node --test test/loop.test.mjs test/engine.test.mjs",
    "check": "node --check lib/index.js"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "llm",
    "multi-agent",
    "parallel-thinking",
    "推理",
    "多路思考"
  ]
}
